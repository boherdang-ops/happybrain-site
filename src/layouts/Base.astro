---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import org from '../data/org.json';

const { title, description } = Astro.props;

// 사이트 이름·설명은 /admin → 페이지 내용 → 법인 정보에서 수정할 수 있습니다.
const siteName = org.siteName || org.shortName || 'AI행정혁신연구소';
const siteTagline = org.siteTagline || org.name || siteName;
const siteUrl = 'https://happybrain.ai.kr';

const fullTitle = title ? `${title} | ${siteName}` : siteTagline;

const desc = description ?? org.siteDescription ?? org.intro;

const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

const ogImage = new URL('/kpa-logo.png', siteUrl).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <!-- 네이버 사이트 소유확인 -->
    <meta name="naver-site-verification" content="c6c0444385978e288148dd3007e38bbff5f45b7b" />

    <!-- 기본 SEO -->
    <title>{fullTitle}</title>

    <meta name="description" content={desc} />

    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter / SNS -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 사이트 아이콘 -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- 구조화 데이터 : WebSite -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteName,
        url: siteUrl,
        inLanguage: 'ko-KR',
        description: desc
      })}
    />

    <!-- 구조화 데이터 : Organization (기관) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'EducationalOrganization',
        name: org.name,
        alternateName: org.shortName,
        url: siteUrl,
        logo: ogImage,
        description: org.intro,
        ...(org.address ? { address: org.address } : {}),
        ...(org.phone ? { telephone: org.phone } : {}),
        ...(org.email ? { email: org.email } : {})
      })}
    />
  </head>

  <body>
    <a class="skip" href="#main">본문 바로가기</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
