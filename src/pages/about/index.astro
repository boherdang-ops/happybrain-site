---
import Base from '../../layouts/Base.astro';
import about from '../../data/about.json';
import org from '../../data/org.json';

const { name, penName, intro, greeting, signName, signTitle, focus, career, ctaHeading, ctaBody } = about;
---
<Base title="소개" description={org.intro}>
  <!-- 표지: 법인 -->
  <section class="intro">
    <div class="wrap intro-inner">
      <p class="eyebrow">About</p>
      {org.mission && <p class="mission">{org.mission}</p>}
      <p class="intro-lead">{org.intro}</p>
    </div>
  </section>

  <!-- 사업 영역 -->
  {org.services?.length > 0 && (
    <section class="section wrap">
      <p class="eyebrow">Services</p>
      <h2 class="sec-title">사업 영역</h2>
      <div class="focus">
        {org.services.map((f, i) => (
          <div class="focus-item">
            <span class="focus-idx">{String(i + 1).padStart(2, '0')}</span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- 대표 프로필 -->
  <section class="section wrap profile-strip">
    <p class="eyebrow">Greeting</p>
    <h2 class="sec-title">인사말</h2>
    <div class="profile">
      <div class="profile-head">
        <div class="greeting">
          {(greeting || intro || '').split('\n').filter(Boolean).map((para) => <p>{para}</p>)}
        </div>
        <p class="sign">
          {signTitle && <span class="sign-title">{signTitle}</span>}
          <span class="sign-name">{signName || name}</span>
        </p>
      </div>
      <div class="profile-focus">
        {focus.map((f) => (
          <div class="pf-item">
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 이력 -->
  <section class="section wrap">
    <p class="eyebrow">Record</p>
    <h2 class="sec-title">교육 실적</h2>
    <ul class="career">
      {career.map((c) => (
        <li>
          <span class="period">{c.period}</span>
          <span class="role">{c.role}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- CTA -->
  <section class="section cta-strip">
    <div class="wrap cta-inner">
      <h2>{ctaHeading}</h2>
      <p>{ctaBody}</p>
      <a class="btn btn--on-navy" href="/contact/">문의하기</a>
    </div>
  </section>
</Base>

<style>
  .intro { border-bottom: 1px solid var(--line); }
  .intro-inner { padding-block: clamp(3.5rem, 9vw, 6rem); max-width: 44rem; }
  .intro h1 { margin: 1rem 0 1.4rem; display: flex; align-items: baseline; gap: .8rem; flex-wrap: wrap; }
  .pen { font-family: var(--mono); font-size: .95rem; font-weight: 400; letter-spacing: .06em; color: var(--gold); }
  .intro-lead { font-size: clamp(1.1rem, 2.4vw, 1.35rem); line-height: 1.75; color: var(--ink); }

  .sec-title { margin: .5rem 0 2.2rem; }

  .focus { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 2rem; }
  .focus-item { padding-top: 1.2rem; border-top: 2px solid var(--gold); }
  .focus-idx { font-family: var(--mono); font-size: .78rem; color: var(--gold); }
  .focus-item h3 { margin: .5rem 0 .7rem; }
  .focus-item p { color: var(--muted); line-height: 1.7; margin: 0; }

  .career { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); max-width: 46rem; }
  .career li { display: grid; grid-template-columns: 6rem 1fr; gap: 1.5rem; padding: 1.1rem .25rem; border-bottom: 1px solid var(--line); align-items: baseline; }
  .period { font-family: var(--mono); font-size: .78rem; color: var(--gold); }
  .role { font-size: 1.02rem; }

  .mission { font-family: var(--serif); font-size: clamp(1.05rem, 2.4vw, 1.3rem); color: var(--gold); margin: 0 0 1.2rem; }
  .profile-strip { background: var(--paper-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .profile { display: grid; grid-template-columns: 1fr 1.3fr; gap: 2.5rem; align-items: start; }
  .greeting p { line-height: 1.85; color: var(--ink); margin: 0 0 1em; }
  .sign { margin: 1.4rem 0 0; display: flex; align-items: baseline; gap: .6rem; justify-content: flex-start; }
  .sign-title { font-family: var(--mono); font-size: .76rem; letter-spacing: .08em; color: var(--muted); }
  .sign-name { font-family: var(--serif); font-weight: 700; font-size: 1.25rem; color: var(--ink); }
  .profile-focus { display: flex; flex-direction: column; gap: 1.2rem; }
  .pf-item h3 { font-size: 1.05rem; margin: 0 0 .35rem; }
  .pf-item p { margin: 0; color: var(--muted); line-height: 1.65; font-size: .95rem; }
  @media (max-width: 700px) { .profile { grid-template-columns: 1fr; gap: 1.5rem; } }

  .cta-strip { background: var(--navy-deep); color: var(--paper-on-navy); }
  .cta-inner { text-align: center; max-width: 40rem; margin-inline: auto; }
  .cta-inner h2 { color: #fff; }
  .cta-inner p { margin: 1rem 0 1.8rem; color: var(--paper-on-navy); }
  @media (max-width: 520px) { .career li { grid-template-columns: 1fr; gap: .2rem; } }
</style>
