---
import Base from '../../layouts/Base.astro';
import contact from '../../data/contact.json';
import inquiry from '../../data/inquiry.json';
import org from '../../data/org.json';
import {publicLink} from '../../lib/banner.mjs';
const email = org.email || contact.email;
---
<Base title="사업 문의" description="지방정부·공공기관을 위한 교육 문의와 사업 관련 Q&A.">
 <section class="page-head"><div class="wrap"><p class="eyebrow">CONTACT</p><h1>사업 문의</h1><p class="page-lead">기관의 교육대상과 일정, 해결하려는 업무를 바탕으로 교육·컨설팅 방향을 함께 검토합니다.</p></div></section>
 <section class="section wrap contact-grid">
  <div class="education-inquiry" aria-labelledby="education-inquiry-heading"><p class="eyebrow">EDUCATION INQUIRY</p><h2 id="education-inquiry-heading">교육 문의</h2><a class="email" href={`mailto:${email}`}>{email}</a><p class="note">{contact.note}</p>{org.phone&&<p class="phone"><strong>대표 전화</strong><a href={`tel:${org.phone.replace(/[^0-9+]/g,'')}`}>{org.phone}</a></p>}<div class="inquiry-guide"><h3>문의 시 알려주세요</h3><ul><li>기관명과 담당 부서</li><li>교육대상·인원·희망 일정</li><li>관심 있는 교육과정 또는 해결하려는 업무</li></ul></div></div>
  <div class="faq" aria-labelledby="faq-heading"><p class="eyebrow">Q&A</p><h2 id="faq-heading">자주 묻는 질문</h2><div class="faq-list">{(contact.faqs||[]).map(item=><details><summary>{item.question}</summary><div class="faq-answer"><p>{item.answer}</p>{publicLink(item.link)&&<a href={publicLink(item.link)}>{item.linkLabel||'관련 안내 보기'} ↗</a>}</div></details>)}</div><div class="question-box"><button type="button" id="question-toggle" class="btn" aria-expanded="false" aria-controls="question-panel">질문하기</button><section id="question-panel" hidden aria-labelledby="question-heading"><h3 id="question-heading">질문하기</h3><p>교육·사업 관련 문의를 자유롭게 적어 주세요. 문의는 비공개로 접수되어 법인 메일로 전달됩니다.</p><form id="question-form" data-endpoint={inquiry.endpoint} data-key={inquiry.anonKey}><label for="question-name">이름·기관명 <span>(선택)</span></label><input id="question-name" name="name" maxlength="80" autocomplete="organization"/><label for="question-email">답변받을 이메일 <span>(필수)</span></label><input id="question-email" name="email" type="email" maxlength="254" autocomplete="email" required/><label for="question-message">문의 내용 <span>(필수)</span></label><textarea id="question-message" name="message" rows="7" minlength="5" maxlength="5000" placeholder="궁금한 점이나 필요한 교육·사업 내용을 적어 주세요." required></textarea><div class="question-trap" aria-hidden="true"><label for="question-website">웹사이트</label><input id="question-website" name="website" tabindex="-1" autocomplete="off"/></div><label class="question-consent"><input name="consent" type="checkbox" required/><span>문의 처리를 위해 입력한 정보가 AI행정혁신연구소에 전달되는 것에 동의합니다.</span></label><p class="question-note">개인정보·비공개·보안 자료는 적지 마세요. 공개 게시판에는 표시되지 않습니다.</p><button id="question-send" class="btn" type="submit">질문 보내기</button><p id="question-status" role="status" aria-live="polite"></p></form></section></div></div>
 </section>
</Base>

<script>
 const toggle=document.querySelector<HTMLButtonElement>('#question-toggle');const panel=document.querySelector<HTMLElement>('#question-panel');toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));if(panel)panel.hidden=!open;if(open)document.querySelector<HTMLInputElement>('#question-email')?.focus()});
 const form=document.querySelector<HTMLFormElement>('#question-form');let requestId='';let lastPayload='';let busy=false;
 form?.addEventListener('submit',async event=>{event.preventDefault();if(busy||!form.reportValidity())return;const fields=new FormData(form);const payload={name:String(fields.get('name')||'').trim(),email:String(fields.get('email')||'').trim(),message:String(fields.get('message')||'').trim(),website:String(fields.get('website')||''),consent:fields.get('consent')==='on'};const signature=JSON.stringify(payload);if(signature!==lastPayload){requestId=crypto.randomUUID();lastPayload=signature}const button=document.querySelector<HTMLButtonElement>('#question-send')!;const status=document.querySelector<HTMLElement>('#question-status')!;busy=true;button.disabled=true;form.setAttribute('aria-busy','true');status.textContent='질문을 보내고 있습니다…';try{const response=await fetch(form.dataset.endpoint!,{method:'POST',headers:{'Content-Type':'application/json','apikey':form.dataset.key!,'Authorization':'Bearer '+form.dataset.key},body:JSON.stringify({...payload,id:requestId}),signal:AbortSignal.timeout(35000)});let result;try{result=await response.json()}catch{throw Error('서버 응답을 확인하지 못했습니다. 입력 내용은 유지됩니다. 잠시 후 다시 시도해 주세요.')}if(!response.ok||result.ok!==true)throw Error(result.error||'질문을 전송하지 못했습니다. 잠시 후 다시 시도해 주세요.');form.reset();requestId='';lastPayload='';status.textContent='질문이 접수되어 법인 메일로 전달되었습니다. 답변은 입력하신 이메일로 보내드립니다.';}catch(error){status.textContent=error instanceof Error&&error.name!=='TimeoutError'?error.message:'전송 결과를 확인하지 못했습니다. 입력 내용은 유지됩니다. 잠시 후 다시 시도해 주세요.';}finally{busy=false;button.disabled=false;form.removeAttribute('aria-busy')}});
</script>
<style>
h1,h2,h3{font-family:var(--sans);word-break:keep-all}.page-head{background:var(--navy-deep);color:var(--paper-on-navy)}.page-head .wrap{padding-block:clamp(3rem,8vw,5rem)}.page-head h1{color:#fff;margin-top:.8rem}.page-head .eyebrow{color:var(--gold)}.page-lead{color:var(--paper-on-navy);max-width:36rem;margin:1rem 0 0}.contact-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:64px;align-items:start}.contact-grid h2{font-size:1.6rem;line-height:1.4;margin-bottom:20px}.email{font-size:clamp(1.15rem,2.4vw,1.7rem);font-weight:600;display:inline-block;color:var(--ink);border-bottom:2px solid var(--gold);margin-bottom:20px;max-width:100%;overflow-wrap:anywhere;line-height:1.6}.email:hover{text-decoration:none;color:var(--blue)}.note{font-size:14px;color:var(--muted);line-height:1.85;max-width:31rem}.phone{display:flex;flex-direction:column;gap:5px;margin:24px 0}.phone strong{font-size:13px}.phone a{font-size:15px}.inquiry-guide{border-top:1px solid var(--line);padding-top:23px;margin:26px 0}.inquiry-guide h3{font-size:17px}.inquiry-guide ul{padding-left:20px;margin:14px 0 0;font-size:14px;line-height:1.9;color:var(--muted)}.education-inquiry .btn{font-size:14px}.faq-list{border-top:1px solid #cad7d3}.faq details{border-bottom:1px solid #cad7d3;padding:19px 0}.faq summary{cursor:pointer;font-size:15px;font-weight:600;line-height:1.75;word-break:keep-all}.faq-answer{padding:15px 0 0 18px}.faq-answer p{font-size:14px;color:var(--muted);line-height:1.9;margin:0}.faq-answer a{display:inline-block;margin-top:12px;font-size:13px;font-weight:600}@media(max-width:760px){.contact-grid{grid-template-columns:1fr;gap:40px}.contact-grid h2{font-size:1.4rem}.email{font-size:clamp(1.05rem,5vw,1.5rem)}.section{padding-block:40px}}@media print{.faq details{break-inside:avoid}.education-inquiry .btn{display:none}.faq-answer{padding-left:0}}
.question-box{margin-top:24px}.question-box>button{font-size:14px}.question-box section{margin-top:20px;padding:24px;border:1px solid #c8d5d0;border-radius:4px;background:#fff}.question-box section[hidden]{display:none!important}.question-box h3{font-size:20px;margin-bottom:12px}.question-box section>p{font-size:13px;color:#65747f;line-height:1.8}.question-box form>label:not(.question-consent){display:block;font-size:14px;font-weight:600;margin:18px 0 8px}.question-box label span{font-weight:400;font-size:12px}.question-box input:not([type=checkbox]),.question-box textarea{display:block;width:100%;max-width:100%;border:1px solid #bdcec8;padding:11px;border-radius:3px;background:#fff;font:inherit;font-size:14px;color:var(--ink)}.question-box textarea{resize:vertical;min-height:160px}.question-consent{display:flex;align-items:flex-start;gap:9px;margin-top:18px;line-height:1.7}.question-consent input{margin-top:5px;flex-shrink:0}.question-note{font-size:11px;color:#65747f;line-height:1.7;margin:12px 0 18px}#question-status{font-size:13px;line-height:1.8;margin:16px 0 0;overflow-wrap:anywhere}.question-trap{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}.question-box button:disabled{opacity:.6;cursor:wait}@media(max-width:640px){.question-box section{padding:18px}}@media print{.question-box{display:none}}
</style>
