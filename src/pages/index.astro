---
import display from '../data/display-home.json';
import Base from '../layouts/Base.astro';
import home from '../data/home.json';
import org from '../data/org.json';
import d from '../data/corporate.json';
import {getCollection} from 'astro:content';
const notices=(await getCollection('notices',({data})=>!data.draft)).sort((a,b)=>Number(b.data.pinned)-Number(a.data.pinned)||b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
const posts=(await getCollection('writing',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Base>
<section class="corp-hero"><div class="wrap hero-layout"><div class="hero-copy"><p class="eyebrow">{home.heroEyebrow}</p><h1>{home.heroTitle.split('\n').map((s,i)=><>{i>0&&<br/>}{s}</>)}</h1><p class="hero-lead">{home.heroLead}</p><div class="hero-actions"><a class="btn bright" href={display.inquiryUrl}>{display.inquiryLabel} <span aria-hidden="true">↗</span></a><a class="text-link" href="#services">{display.servicesLabel} <span aria-hidden="true">↓</span></a></div><p class="hero-mission">{org.mission}</p></div><div class="service-map" aria-label="교육·진단·학습·실무지원으로 이어지는 서비스"><p class="map-label">{display.mapTitle}</p>{d.services.map((s,i)=><a href={s.url}><span class="map-no">0{i+1}</span><div><span>{s.eyebrow}</span><strong>{s.title}</strong><p>{s.desc}</p></div><span class="map-arrow" aria-hidden="true">↗</span></a>)}<p class="map-foot">{display.mapFoot}</p></div></div></section>
<section class="section wrap" id="business"><div class="section-heading"><p class="eyebrow">{display.businessEyebrow}</p><h2>{d.businessTitle.split('\n').map((s,i)=><>{i>0&&<br/>}{s}</>)}</h2><p>{d.businessIntro}</p></div><div class="business-grid">{org.services.map((b,i)=><article><span class="minor-index">0{i+1}</span><h3>{b.title}</h3><p>{b.body}</p></article>)}</div><a class="under-link" href="/about/">{display.aboutLabel} →</a></section>
<section class="service-section" id="services"><div class="wrap"><div class="section-heading"><p class="eyebrow">{display.servicesEyebrow}</p><h2>{d.servicesTitle.split('\n').map((s,i)=><>{i>0&&<br/>}{s}</>)}</h2><p>{d.servicesIntro}</p></div><div class="services-grid">{d.services.map((s,i)=><a class={`service-panel service-${s.key}`} href={s.url}><span class="service-top"><span>{s.eyebrow}</span><span aria-hidden="true">↗</span></span><h3>{s.title}</h3><p class="service-desc">{s.desc}</p><p>{s.detail}</p><span class="service-cta">{s.label} <span aria-hidden="true">→</span></span></a>)}</div></div></section>
<section class="section wrap" id="education"><div class="course-layout"><div class="section-heading"><p class="eyebrow">{display.educationEyebrow}</p><h2>{d.coursesTitle}</h2><p>{d.coursesIntro}</p><a class="under-link" href={d.services.find(s=>s.key==='education')?.url || '#services'}>{display.coursesLabel} ↗</a></div><div class="course-list">{d.courses.map((c,i)=><a href={c.url}><span class="minor-index">0{i+1}</span><div><h3>{c.title}</h3><p>{c.target} <span>· {c.duration}</span></p></div><span aria-hidden="true">↗</span></a>)}</div></div></section>
<section class="approach-section"><div class="wrap"><div class="section-heading"><p class="eyebrow">{display.approachEyebrow}</p><h2>{d.approachTitle}</h2><p>{d.approachIntro}</p></div><ol class="approach-grid">{d.steps.map((s,i)=><li><span>STEP 0{i+1}</span><h3>{s.title}</h3><p>{s.body}</p></li>)}</ol></div></section>
<section class="section wrap" id="news"><div class="section-head"><div><p class="eyebrow">{display.newsEyebrow}</p><h2>{display.newsTitle}</h2></div><a class="under-link" href="/news/">{display.newsMore} →</a></div><p class="section-note">{display.newsIntro}</p><div class="insight-list">{notices.map(n=><a href={`/news/${n.id}/`}><span>{n.data.pinned?'고정 · ':''}{n.data.category}</span><h3>{n.data.title}</h3><span aria-hidden="true">↗</span></a>)}</div>{notices.length===0&&<p class="section-note">등록된 소식이 없습니다.</p>}</section>
<section class="section wrap" id="insights"><div class="section-head"><div><p class="eyebrow">{display.insightsEyebrow}</p><h2>{d.insightsTitle}</h2></div><a class="under-link" href="/writing/">{display.insightsMore} →</a></div><p class="section-note">{d.insightsIntro}</p><div class="insight-list">{posts.map(p=><a href={`/writing/${p.id}/`}><span>{p.data.category}</span><h3>{p.data.title}</h3><span aria-hidden="true">↗</span></a>)}</div><div class="resource-links">{display.resourceLinks.map(link=><a href={link.url}>{link.label} ↗</a>)}</div></section>

</Base>
<style>
:global(:root){--measure:78rem}h1,h2,h3{font-family:var(--sans);letter-spacing:-.045em;word-break:keep-all}h2{font-size:clamp(1.8rem,3.2vw,2.7rem);line-height:1.35}h3{font-size:1.3rem;line-height:1.45}p{word-break:keep-all}.corp-hero{background:#132c3a;color:white;position:relative;overflow:hidden}.hero-layout{display:grid;grid-template-columns:1.2fr 1fr;gap:70px;align-items:center;padding-block:88px 76px}.corp-hero .eyebrow{font-family:var(--sans);font-size:12px;letter-spacing:.08em;color:#c7d9da}.corp-hero h1{font-size:clamp(2.7rem,4.8vw,4.3rem);line-height:1.16;color:#fff;margin:20px 0 24px;font-weight:700}.hero-lead{max-width:540px;font-size:17px;color:#cbd9dd;line-height:1.85}.hero-actions{display:flex;align-items:center;gap:26px;flex-wrap:wrap;margin-top:30px}.bright{background:#e7c791;color:#182d39;border-color:#e7c791;justify-content:space-between;gap:32px}.bright:hover{background:#f1d7ae;border-color:#f1d7ae;color:#182d39}.text-link{color:white;font-size:14px}.hero-mission{font-size:12px;color:#9fb8bf;border-top:1px solid #ffffff26;padding-top:22px;margin:38px 0 0}.service-map{border:1px solid #ffffff30;border-radius:4px;background:#ffffff05;padding:26px 30px}.map-label{font-family:var(--mono);font-size:10px;letter-spacing:.18em;color:#cdb789;margin:0 0 10px}.service-map a{display:flex;align-items:center;gap:18px;padding:24px 0;border-bottom:1px solid #ffffff26;color:#fff}.service-map a:hover{text-decoration:none}.map-no{font-family:var(--mono);color:#9db4ba;font-size:12px}.service-map a div{flex:1}.service-map a div>span{font-family:var(--mono);font-size:9px;letter-spacing:.08em;color:#9db4ba;display:block}.service-map strong{display:block;font-size:23px;font-weight:600;margin:3px 0 5px}.service-map p:not(.map-label):not(.map-foot){font-size:12px;line-height:1.6;color:#c4d1d5;margin:0}.map-arrow{font-size:21px;color:#e7c791}.map-foot{margin:20px 0 0;font-size:11px;color:#9db4ba}.section-heading{max-width:780px;margin-bottom:36px}.section-heading .eyebrow{margin-bottom:15px}.section-heading>p:not(.eyebrow){font-size:16px;line-height:1.85;color:#647281;margin:20px 0 0}.business-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px;margin:44px 0 26px}.business-grid article{border-top:2px solid #bda16c;padding-top:20px}.minor-index{font-family:var(--mono);font-size:11px;color:#8e7652}.business-grid h3{margin:14px 0}.business-grid p{font-size:15px;color:#647281;line-height:1.85}.under-link{font-size:14px;font-weight:600;color:var(--ink);display:inline-block;margin-top:10px}.service-section{background:#edf1f0;border-block:1px solid #dee5e3;padding-block:76px}.services-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.service-panel{display:flex;flex-direction:column;padding:28px;background:white;border:1px solid #d6e0df;color:var(--ink);transition:transform .15s,border-color .15s;border-radius:3px}.service-panel:hover{text-decoration:none;transform:translateY(-3px);border-color:#5e8b88}.service-top{display:flex;justify-content:space-between;font-family:var(--mono);font-size:10px;color:#52716d;letter-spacing:.08em;margin-bottom:35px}.service-panel h3{font-size:27px;margin-bottom:18px}.service-panel .service-desc{font-weight:600;color:#304a56;font-size:17px;line-height:1.6}.service-panel p{color:#647281;font-size:14px;line-height:1.85}.service-cta{margin-top:auto;padding-top:22px;border-top:1px solid #dfe5e3;display:flex;justify-content:space-between;font-size:14px;font-weight:700}.service-practice{background:#173b3a;color:white;border-color:#173b3a}.service-practice h3,.service-practice .service-desc{color:white}.service-practice p,.service-practice .service-top{color:#bfd4ce}.service-practice .service-cta{border-color:#ffffff30}.course-layout{display:grid;grid-template-columns:1fr 1.5fr;gap:70px}.course-layout .section-heading h2{max-width:330px}.course-list{border-top:1px solid #cbd6d5}.course-list>a{display:flex;align-items:baseline;gap:20px;padding:22px 0;border-bottom:1px solid #dce3e1;color:var(--ink)}.course-list>a:hover{text-decoration:none}.course-list>a>div{flex:1}.course-list h3{font-size:17px;line-height:1.6}.course-list p{font-size:12px;color:#647281;margin:7px 0 0}.course-list p span{white-space:nowrap}.approach-section{background:#f1ede5;padding-block:65px}.approach-grid{padding:0;list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px;margin:0}.approach-grid li{border-top:1px solid #cbbda5;padding-top:24px}.approach-grid li>span{font-family:var(--mono);font-size:10px;color:#8c724c}.approach-grid h3{margin:14px 0 10px}.approach-grid p{font-size:14px;line-height:1.85;color:#647281}.section-note{font-size:15px;color:#647281}.insight-list{border-top:1px solid #cbd6d5}.insight-list a{display:grid;grid-template-columns:140px 1fr auto;gap:24px;align-items:center;padding:24px 0;border-bottom:1px solid #dce3e1;color:var(--ink)}.insight-list a>span:first-child{font-size:12px;color:#647281}.insight-list h3{font-size:18px}.resource-links{display:flex;flex-wrap:wrap;gap:24px;margin-top:25px;font-size:13px}.corp-cta{background:#132c3a;color:white;padding-block:65px}.cta-layout{display:flex;align-items:center;justify-content:space-between;gap:40px}.corp-cta h2{color:white;font-size:clamp(1.8rem,3vw,2.5rem)}.corp-cta p:not(.eyebrow){max-width:670px;font-size:15px;line-height:1.85;color:#bbccd1;margin:18px 0 0}.corp-cta .bright{flex-shrink:0}.corp-cta .eyebrow{font-size:10px}.section{padding-block:76px}
@media(max-width:1050px){.hero-layout{gap:35px}.service-map{padding:20px}.services-grid{gap:14px}.service-panel{padding:24px}.course-layout{gap:36px}}
@media(max-width:760px){.hero-layout{grid-template-columns:1fr;padding-block:52px;gap:40px}.corp-hero h1{font-size:clamp(2.5rem,8.5vw,3.5rem)}.hero-lead{font-size:15px}.hero-mission{margin-top:26px}.service-map{padding:20px 24px}.service-map a{padding:18px 0}.service-map strong{font-size:21px}.section,.service-section{padding-block:50px}.business-grid,.services-grid,.approach-grid{grid-template-columns:1fr;gap:24px}.business-grid{margin-top:28px}.business-grid article{padding-top:16px}.business-grid h3{display:inline;margin-left:14px}.business-grid p{margin-top:14px}.service-top{margin-bottom:18px}.service-panel h3{font-size:25px}.course-layout{grid-template-columns:1fr;gap:14px}.course-layout .section-heading h2{max-width:none}.section-heading{margin-bottom:26px}.insight-list a{grid-template-columns:1fr auto;gap:8px}.insight-list a>span:first-child{grid-column:1/-1}.insight-list h3{font-size:17px}.approach-section{padding-block:50px}.cta-layout{align-items:flex-start;flex-direction:column;gap:24px}.resource-links{gap:18px}.section-head{margin-bottom:18px}.hero-actions{gap:20px}.corp-hero .eyebrow{font-size:10px}}
@media print{.corp-hero,.corp-cta,.service-practice{background:white;color:var(--ink)}.corp-hero h1,.corp-cta h2,.service-practice h3{color:var(--ink)}.service-map{display:none}.hero-layout{display:block}.section,.service-section,.approach-section,.corp-cta,.hero-layout{padding-block:16px}.services-grid,.business-grid,.approach-grid{gap:16px}.service-panel{break-inside:avoid}.hero-actions,.resource-links{display:none}.corp-hero p,.corp-cta p,.service-practice p{color:#333!important}}
</style>
