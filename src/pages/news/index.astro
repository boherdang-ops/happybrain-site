---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('notices',({data})=>!data.draft)).sort((a,b)=>Number(b.data.pinned)-Number(a.data.pinned)||b.data.date.valueOf()-a.data.date.valueOf());
const categories=['공지','홍보','AI 정책','교육 정보'];
const fmt=d=>new Intl.DateTimeFormat('ko-KR',{timeZone:'Asia/Seoul',year:'numeric',month:'2-digit',day:'2-digit'}).format(d);
---
<Base title="공지·소식" description="AI행정혁신연구소의 공지와 홍보, 공공 AI 정책 및 교육 정보.">
<section class="page-head"><div class="wrap"><p class="eyebrow">NEWS & NOTICES</p><h1>공지·소식</h1><p>법인 소식과 공고, 공공 AI 정책 및 교육 정보를 전합니다.</p></div></section>
<section class="section wrap"><div class="board-controls"><div role="group" aria-label="게시글 분류"><button type="button" data-category="all" aria-pressed="true">전체</button>{categories.map(c=><button type="button" data-category={c} aria-pressed="false">{c}</button>)}</div><label><span class="visually-hidden">게시글 검색</span><input type="search" id="notice-search" placeholder="제목·내용 검색" aria-label="게시글 검색"/></label></div>
<div class="board-list">{posts.map(p=><a class="board-item" href={`/news/${p.id}/`} data-notice data-category={p.data.category} data-search={`${p.data.title} ${p.data.summary||''}`}><span class="board-meta">{p.data.pinned&&<b>고정</b>}{p.data.category}</span><div><h2>{p.data.title}</h2>{p.data.summary&&<p>{p.data.summary}</p>}{p.data.attachments.length>0&&<span class="attachment-note">첨부자료 {p.data.attachments.length}건</span>}</div><time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time></a>)}</div>
<p id="notice-empty" role="status" hidden={posts.length>0}>{posts.length?'조건에 맞는 게시글이 없습니다.':'등록된 소식이 없습니다.'}</p>
</section></Base>
<script>
const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-notice]'));const search=document.querySelector<HTMLInputElement>('#notice-search');const buttons=document.querySelectorAll<HTMLButtonElement>('[data-category][type="button"]');let category='all';function apply(){const query=(search?.value||'').trim().toLowerCase();let count=0;cards.forEach(card=>{const show=(category==='all'||category===card.dataset.category)&&(!query||(card.dataset.search||'').toLowerCase().includes(query));card.hidden=!show;if(show)count++});const empty=document.querySelector<HTMLElement>('#notice-empty');if(empty)empty.hidden=count>0;}buttons.forEach(button=>button.addEventListener('click',()=>{category=button.dataset.category||'all';buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));apply()}));search?.addEventListener('input',apply);
</script>
<style>
h1,h2{font-family:var(--sans);word-break:keep-all}.page-head{background:#edf1f0;border-bottom:1px solid #d8e1df}.page-head .wrap{padding-block:54px}.page-head h1{margin:12px 0 18px}.page-head p:last-child{color:#61717b;margin:0}.board-controls{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-bottom:30px}.board-controls>div{display:flex;flex-wrap:wrap;gap:8px}.board-controls button{font:inherit;font-size:13px;border:1px solid #cad7d3;background:transparent;padding:8px 14px;cursor:pointer;border-radius:3px;color:#203a43}.board-controls button[aria-pressed=true]{background:#173b3a;color:white;border-color:#173b3a}.board-controls input{max-width:100%;width:230px;padding:10px 13px;border:1px solid #cad7d3;background:white;font:inherit;font-size:14px}.visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.board-list{border-top:2px solid #234651}.board-item{display:grid;grid-template-columns:110px minmax(0,1fr) 110px;gap:24px;padding:26px 0;border-bottom:1px solid #d9e1de;color:var(--ink);align-items:baseline}.board-item[hidden]{display:none!important}.board-item:hover{text-decoration:none}.board-item h2{font-size:19px;line-height:1.5}.board-item p{font-size:14px;color:#65747f;line-height:1.8;margin:9px 0 0}.board-meta{font-size:12px;color:#62786f}.board-meta b{display:block;color:#946c30;font-size:11px;margin-bottom:5px}.board-item time{font-size:12px;color:#65747f;text-align:right}.attachment-note{font-size:11px;color:#62786f;display:block;margin-top:8px}#notice-empty{color:#65747f;padding:50px 0;text-align:center;font-size:15px}@media(max-width:640px){.board-item{grid-template-columns:1fr auto;gap:12px;padding:22px 0}.board-item>div{grid-column:1/-1;grid-row:2}.board-meta b{display:inline;margin-right:8px}.board-item time{grid-column:2;grid-row:1}.board-controls{gap:16px}.board-controls label,.board-controls input{width:100%}.page-head .wrap{padding-block:36px}}
</style>
